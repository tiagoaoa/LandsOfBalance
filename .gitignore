# Godot 4+ specific ignores
.godot/

# Godot-specific ignores
*.import

# Exported binaries (use GitHub Releases for APKs)
build/

# External addons/plugins (can be reinstalled)
addons/humanizer/

# Humanizer generated assets (can be regenerated or fetched separately)
humanizer/

# Temporary files
temp_assets*/

# Screenshots (optional, can be large)
screenshots/

# Export presets (needed for building)
# export_presets.cfg

# OS generated files
.DS_Store
Thumbs.db

# Web export bundle (huge, regenerate with the HTML5 preset)
lands-of-balance-web/

# FBX embedded-texture folders extracted by the importer (regenerated on import)
*.fbm/

# Local tooling scratch
.codex/
adblog.txt
