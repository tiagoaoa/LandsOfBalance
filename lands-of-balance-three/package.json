{
  "name": "lands-of-balance-three",
  "version": "1.0.0",
  "description": "Three.js port of Lands of Balance / Douglass The Keeper",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "bake": "blender --background --factory-startup --python scripts/bake_characters.py",
    "check": "node scripts/console_check.mjs",
    "probe:bow": "node scripts/probe_bow.mjs"
  },
  "dependencies": {
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.14"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
